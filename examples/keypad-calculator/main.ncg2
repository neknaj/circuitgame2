(using nor)

(func full-add (in left right carry-in) (out sum carry-out)
  (def different (::ncg2lib::logic::xor left right))
  (def sum (::ncg2lib::logic::xor different carry-in))
  (def both (::ncg2lib::logic::and left right))
  (def carried (::ncg2lib::logic::and different carry-in))
  (def carry-out (::ncg2lib::logic::or both carried)))

;; 減算では右辺の反転に 1 を加える。借りが生じると borrow は 1 になる。
(func add-subtract (in (left (bits 8)) (right (bits 8)) subtract) (out (word (bits 8)) borrow)
  (def left-0 (bit left 0))
  (def right-0 (bit right 0))
  (def operand-0 (::ncg2lib::logic::xor right-0 subtract))
  (def (sum-0 carry-0) (full-add left-0 operand-0 subtract))
  (def left-1 (bit left 1))
  (def right-1 (bit right 1))
  (def operand-1 (::ncg2lib::logic::xor right-1 subtract))
  (def (sum-1 carry-1) (full-add left-1 operand-1 carry-0))
  (def left-2 (bit left 2))
  (def right-2 (bit right 2))
  (def operand-2 (::ncg2lib::logic::xor right-2 subtract))
  (def (sum-2 carry-2) (full-add left-2 operand-2 carry-1))
  (def left-3 (bit left 3))
  (def right-3 (bit right 3))
  (def operand-3 (::ncg2lib::logic::xor right-3 subtract))
  (def (sum-3 carry-3) (full-add left-3 operand-3 carry-2))
  (def left-4 (bit left 4))
  (def right-4 (bit right 4))
  (def operand-4 (::ncg2lib::logic::xor right-4 subtract))
  (def (sum-4 carry-4) (full-add left-4 operand-4 carry-3))
  (def left-5 (bit left 5))
  (def right-5 (bit right 5))
  (def operand-5 (::ncg2lib::logic::xor right-5 subtract))
  (def (sum-5 carry-5) (full-add left-5 operand-5 carry-4))
  (def left-6 (bit left 6))
  (def right-6 (bit right 6))
  (def operand-6 (::ncg2lib::logic::xor right-6 subtract))
  (def (sum-6 carry-6) (full-add left-6 operand-6 carry-5))
  (def left-7 (bit left 7))
  (def right-7 (bit right 7))
  (def operand-7 (::ncg2lib::logic::xor right-7 subtract))
  (def (sum-7 carry-7) (full-add left-7 operand-7 carry-6))
  (def word (concat sum-0 sum-1 sum-2 sum-3 sum-4 sum-5 sum-6 sum-7))
  (def not-carried (::ncg2lib::logic::not carry-7))
  (def borrow (::ncg2lib::logic::and subtract not-carried)))
