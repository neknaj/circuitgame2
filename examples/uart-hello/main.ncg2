(using nor)

;; index が 0 のとき low、1 のとき high を選ぶ。
(func choose (in index low high) (out value)
  (def inverted (::ncg2lib::logic::not index))
  (def low-selected (::ncg2lib::logic::and inverted low))
  (def high-selected (::ncg2lib::logic::and index high))
  (def value (::ncg2lib::logic::or low-selected high-selected)))

;; phase 0〜7 はデータ、8 は開始ビット、9 は停止ビット。
(func uart-bit (in (byte (bits 8)) (phase (bits 4))) (out tx)
  (def data-0 (bit byte 0))
  (def data-1 (bit byte 1))
  (def data-2 (bit byte 2))
  (def data-3 (bit byte 3))
  (def data-4 (bit byte 4))
  (def data-5 (bit byte 5))
  (def data-6 (bit byte 6))
  (def data-7 (bit byte 7))
  (def select-0 (bit phase 0))
  (def select-1 (bit phase 1))
  (def select-2 (bit phase 2))
  (def select-3 (bit phase 3))
  (def pair-0 (choose select-0 data-0 data-1))
  (def pair-1 (choose select-0 data-2 data-3))
  (def pair-2 (choose select-0 data-4 data-5))
  (def pair-3 (choose select-0 data-6 data-7))
  (def lower (choose select-1 pair-0 pair-1))
  (def upper (choose select-1 pair-2 pair-3))
  (def sent-data (choose select-2 lower upper))
  (def tx (choose select-3 sent-data select-0)))
